{
  "name": "nacurena-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/localize-404.mjs",
    "lint": "eslint .",
    "pretypecheck": "next typegen",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "arch": "depcruise src --config .dependency-cruiser.cjs && tsc -p src/os/domain/tsconfig.json",
    "test:e2e": "playwright test",
    "preview": "serve out -l 4173 --no-clipboard --no-port-switching"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "gsap": "3.15.0",
    "next": "16.4.5",
    "next-intl": "4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.5",
    "fast-check": "^4.10.2",
    "jsdom": "^29.1.1",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.4",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "serve": {
      "compression": "1.8.2"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    }
  },
  "license": "MIT"
}
